load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

package(
    default_visibility = [
      "//visibility:public"],
)

ddk_headers(
    name = "uapi_headers",
    hdrs = glob([
      "include/uapi/eva/media/*.h",
    ]),
    includes = ["include/uapi/eva"]
)
ddk_headers(
    name = "msm_headers",
    hdrs = glob([
      "msm/eva/*.h",
    ]),
    includes = ["msm","msm/eva"]
)

ddk_headers(
    name = "eva_drivers_headers",
    hdrs = [":uapi_headers", ":msm_headers"]
)
