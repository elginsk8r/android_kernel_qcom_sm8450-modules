# Kleaf DDK translation of Kbuild, see motorola/moto_modules.bzl
load("//vendor/motorola/sm6475-modules/motorola:moto_modules.bzl", "moto_module")

moto_module(
    name = "qpnp_adaptive_charge",
    srcs = [
        "qpnp_adaptive_charge.c",
    ] + glob(["**/*.h"]),
    # KBUILD_OPTIONS of the Makefile
    make_variables = [
        "CONFIG_USE_MMI_CHARGER",
    ],
    conditional_defines = {
        "CONFIG_USE_MMI_CHARGER": [
            "USE_MMI_CHARGER",
        ],
        "CONFIG_USE_MMI_GLINK_CHARGER": [
            "USE_MMI_GLINK_CHARGER",
        ],
        "ADAPTIVE_TOLERANCE_OPTIMIZATION": [
            "ADAPTIVE_TOLERANCE_OPTIMIZATION",
        ],
    },
    deps = [
        "//vendor/motorola/sm6475-modules/motorola/drivers/power/mmi_charger:headers",
        "//vendor/motorola/sm6475-modules/motorola/drivers/power/mmi_charger:%b_mmi_charger",
    ],
)
